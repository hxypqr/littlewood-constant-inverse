LittlewoodInverse.quantitative_theorem : LittlewoodInverse.QuantitativeTheorem
LittlewoodInverse.structural_inverse_theorem : LittlewoodInverse.StructuralInverseTheorem
LittlewoodInverse.macroscopic_energy_corollary (K β Δ δ : ℝ) (hK : 1 ≤ K) (hβ : 0 < β) (hβ1 : β ≤ 1) (hΔ : 1 ≤ Δ)
  (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
  ∃ N₀ ρ,
    2 ≤ N₀ ∧
      0 < ρ ∧
        ∀ (A : Finset ℤ),
          N₀ ≤ A.card →
            LittlewoodInverse.AdmitsAssemblyModel β Δ A →
              LittlewoodInverse.littlewoodNorm A ≤ K * Real.log ↑A.card →
                ∀ Y ⊆ A, δ * ↑A.card ≤ ↑Y.card → ρ * ↑Y.card ^ 3 ≤ ↑(LittlewoodInverse.additiveEnergy Y)
LittlewoodInverse.exceptional_perturbation_corollary (K ε β Δ H : ℝ) (hK : 1 ≤ K) (hε : 0 < ε) (hε1 : ε < 1 / 2)
  (hβ : 0 < β) (hβ1 : β ≤ 1) (hΔ : 1 ≤ Δ) (hH : 0 ≤ H) :
  ∃ N₀ c C,
    2 ≤ N₀ ∧
      0 < c ∧
        0 < C ∧
          ∀ (A B : Finset ℤ),
            N₀ ≤ A.card →
              LittlewoodInverse.littlewoodNorm A ≤ K * Real.log ↑A.card →
                LittlewoodInverse.AdmitsAssemblyModel β Δ B →
                  ↑(symmDiff A B).card ≤ H * Real.log ↑A.card ^ 2 → LittlewoodInverse.AlmostCover A ε c C
'LittlewoodInverse.quantitative_theorem' depends on axioms: [propext,
 Classical.choice,
 Quot.sound,
 LittlewoodInverse.HardyExternal.bounded_holomorphic_radial_boundary,
 LittlewoodInverse.HardyExternal.schwarz_integral_boundary]
'LittlewoodInverse.structural_inverse_theorem' depends on axioms: [propext,
 Classical.choice,
 Quot.sound,
 LittlewoodInverse.External.mps_weighted,
 LittlewoodInverse.External.polynomial_bsg]
'LittlewoodInverse.macroscopic_energy_corollary' depends on axioms: [propext,
 Classical.choice,
 Quot.sound,
 LittlewoodInverse.External.mps_weighted,
 LittlewoodInverse.External.polynomial_bsg]
'LittlewoodInverse.exceptional_perturbation_corollary' depends on axioms: [propext,
 Classical.choice,
 Quot.sound,
 LittlewoodInverse.External.mps_weighted,
 LittlewoodInverse.External.polynomial_bsg]
